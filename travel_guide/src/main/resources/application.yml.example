spring:
  application:
    name: travel_guide
  datasource:
    url: "jdbc:mysql://localhost:3306/travel_guide?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true"
    username: root
    password: YOUR_MYSQL_PASSWORD
    driver-class-name: com.mysql.cj.jdbc.Driver
  data:
    redis:
      host: localhost
      port: 6379

server:
  port: 8080

mybatis:
  configuration:
    map-underscore-to-camel-case: true

deepseek:
  api-key: YOUR_DEEPSEEK_KEY
  base-url: https://api.deepseek.com
  model: deepseek-chat

bocha:
  api-key: YOUR_BOCHA_KEY
  base-url: https://api.bocha.cn

tencent:
  map-key: YOUR_TENCENT_MAP_KEY

wechat:
  appid: YOUR_WECHAT_APPID
  secret: YOUR_WECHAT_SECRET

jwt:
  secret: YOUR_JWT_SECRET_CHANGE_ME_AT_LEAST_32_CHARACTERS
  expire-hours: 720

vectorstore:
  base-url: YOUR_ZILLIZ_CLUSTER_ENDPOINT
  api-key: YOUR_ZILLIZ_API_KEY
  collection: travel_guide

embedding:
  base-url: https://api.siliconflow.cn/v1
  api-key: YOUR_SILICONFLOW_KEY
  model: BAAI/bge-m3

# 工作流开关（反思校验会增加一次 LLM 调用，可关闭省成本）
workflow:
  reflect: true

# 通义千问 VL（拍照识别景点）
# 注意：新 key 是 sk-ws- 开头，base-url 要带业务空间 ID（在百炼控制台看 API Host）
qwen:
  api-key: YOUR_DASHSCOPE_KEY
  base-url: https://你的WorkspaceId.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
  model: qwen-vl-plus

# 百度智能云（ASR 语音识别 + TTS 语音合成，个人主体方案）
baidu:
  api-key: YOUR_BAIDU_API_KEY
  secret-key: YOUR_BAIDU_SECRET_KEY
